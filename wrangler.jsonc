{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The software repo's canonical self-deploy config: everything a
  // private deployment needs, nothing organization-specific (no routes,
  // no secrets — set those in your own deployment repo or dashboard;
  // Interscript's own deployment lives in interscript/api.interscript.org).
  //
  // Regenerate the ambient runtime types after editing this file:
  //   npm run gen:types   (writes worker-configuration.d.ts)
  "name": "interscript-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // The engine's node loaders are lazily imported; nodejs_compat makes
  // those lazy imports tolerable in the Workers runtime.
  "compatibility_flags": ["nodejs_compat"],
  // Bundled map corpus: static assets served from the edge cache
  // (immutable per deploy); the ASSETS binding is the software's map
  // loader. Fetch/extract a pinned interscript/maps JSON-IR artifact
  // into ./maps first (do not copy maps from the npm package).
  "assets": {
    "directory": "./maps",
    "binding": "ASSETS"
  },
  // ML_ENDPOINT and ML_TOKEN are deployment-supplied, NOT declared
  // here: this software's config carries no placeholder endpoint, and
  // `vars` would pin ML_ENDPOINT to a compile-time literal type in the
  // generated Env for every deployment that overrides it. Both are
  // typed (optional string) in src/env.d.ts via declaration merging
  // into the generated Env — the documented pattern for bindings
  // `wrangler types` cannot see (secrets, deployment vars).
  //   ML_ENDPOINT: POST {model, input} -> {output} with x-api-key auth
  //     (set as a var/secret in YOUR deployment config). Unset (with
  //     ML_TOKEN) means the ml surface answers with a named "ML
  //     inference unavailable" error.
  //   ML_TOKEN is a SECRET, not a var: set it with
  //     npx wrangler secret put ML_TOKEN
  // The plane session probes for a node ONNX backend by dynamically
  // importing "onnxruntime-node"; its binding.js template-requires
  // native .node binaries that no bundler can carry into a Worker.
  // The alias redirects the specifier to an in-repo stub (which throws
  // on evaluation, handled by the backend probe) so wrangler's bundler
  // never traverses the native binary. Corresponds with esbuild's
  // `alias` option.
  "alias": {
    "onnxruntime-node": "./stubs/onnxruntime-node.js"
  },
  // ML_TOKEN is a SECRET, not a var: set it with
  //   npx wrangler secret put ML_TOKEN
  "observability": { "enabled": true }
}
