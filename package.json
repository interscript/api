{
  "name": "@interscript/api-worker",
  "version": "1.1.0",
  "description": "Interscript API software — GraphQL API for transliteration on Cloudflare Workers (or any Workers-compatible runtime). Deploy your own endpoint: see README.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src/index.js",
    "dist/src/index.d.ts",
    "dist/src/server.d.ts",
    "dist/src/schema.d.ts",
    "dist/src/resolvers.d.ts",
    "dist/src/limits.d.ts",
    "dist/src/generated/models.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=neutral --format=esm --minify --outfile=dist/src/index.js --external:node:* --external:hono --external:graphql-yoga --external:@whatwg-node/fetch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src test",
    "format": "prettier --write src test scripts",
    "format:check": "prettier --check src test scripts",
    "typecheck": "tsc --noEmit",
    "fixtures:record": "node scripts/record-fixtures.mjs",
    "gen:models": "node scripts/gen-models.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "graphql-yoga": "^5.0.0",
    "hono": "^4.0.0",
    "interscript": "^3.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260811.1",
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "BSD-3-Clause",
  "repository": "interscript/api",
  "keywords": [
    "transliteration",
    "graphql",
    "cloudflare-workers",
    "interscript"
  ]
}
