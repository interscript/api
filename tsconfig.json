{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    // Ambient Workers runtime types come from the generated
    // worker-configuration.d.ts (npm run gen:types); "node" covers the
    // vitest/test surface. @cloudflare/workers-types is superseded by
    // the generated file.
    "types": ["node"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["src", "test", "worker-configuration.d.ts"]
}
