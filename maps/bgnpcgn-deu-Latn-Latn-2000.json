{"schemaVersion":1,"systemCode":"BGN-PCGN:deu-Latn:Latn:2000","dependencies":["posix","var-kor"],"metadata":{"authority_id":"bgnpcgn","id":"2000","language":"iso-639-2:deu","source_script":"Latn","destination_script":"Latn","name":"Roman-Script Spelling Convention of German (2000 Agreement)","url":"https://assets.publishing.service.gov.uk/government/uploads/system/uploads/attachment_data/file/693794/ROMAN-SCRIPT_SPELLING_CONVENTIONS.pdf","creation_date":"2000","notes":["      The special letter β, known as eszett, [Unicode: 03B2] is a standard letter of the German alphabet and occurs\n      only in word-medial and word-final positions. It is a lowercase letter only, and when a word and/or a name is\n      written entirely in uppercase letters, it is always rendered as SS. As a result of the orthographic reform of\n      German, implemented in August 1998, the β is now rendered ss if it follows a short vowel, but it is still used\n      if it follows a long vowel or a diphthong. In those instances where β cannot be reproduced, the digraph ss\n      may be substituted for it. For alphabetization and sorting purposes, β should be treated as ss.","      In those instances when the vowel letters ä [Unicode: 00E4], ö [Unicode: 00F6], and ü [Unicode: 00FC]\n      cannot be reproduced, the alternate spellings ae, oe, and ue may be substituted."]},"stages":[{"kind":"stage","name":"main","rules":[{"kind":"sub","from":{"kind":"group","items":[{"kind":"string","value":"β"},{"kind":"capture_group","data":{"kind":"alias","name":"upper"}}]},"to":{"kind":"group","items":[{"kind":"string","value":"SS"},{"kind":"capture_ref","id":1}]},"before":{"kind":"any","of":[{"kind":"alias","name":"upper"}]}},{"kind":"sub","from":{"kind":"group","items":[{"kind":"string","value":"Ä"},{"kind":"capture_group","data":{"kind":"alias","name":"upper"}}]},"to":{"kind":"group","items":[{"kind":"string","value":"AE"},{"kind":"capture_ref","id":1}]},"before":{"kind":"any","of":[{"kind":"alias","name":"upper"}]}},{"kind":"sub","from":{"kind":"group","items":[{"kind":"string","value":"Ö"},{"kind":"capture_group","data":{"kind":"alias","name":"upper"}}]},"to":{"kind":"group","items":[{"kind":"string","value":"OE"},{"kind":"capture_ref","id":1}]},"before":{"kind":"any","of":[{"kind":"alias","name":"upper"}]}},{"kind":"sub","from":{"kind":"group","items":[{"kind":"string","value":"Ü"},{"kind":"capture_group","data":{"kind":"alias","name":"upper"}}]},"to":{"kind":"group","items":[{"kind":"string","value":"UE"},{"kind":"capture_ref","id":1}]},"before":{"kind":"any","of":[{"kind":"alias","name":"upper"}]}},{"kind":"parallel","rules":[{"kind":"sub","from":{"kind":"string","value":"Ä"},"to":{"kind":"string","value":"Ae"}},{"kind":"sub","from":{"kind":"string","value":"Ö"},"to":{"kind":"string","value":"Oe"}},{"kind":"sub","from":{"kind":"string","value":"Ü"},"to":{"kind":"string","value":"Ue"}},{"kind":"sub","from":{"kind":"string","value":"ä"},"to":{"kind":"string","value":"ae"}},{"kind":"sub","from":{"kind":"string","value":"ö"},"to":{"kind":"string","value":"oe"}},{"kind":"sub","from":{"kind":"string","value":"ü"},"to":{"kind":"string","value":"ue"}},{"kind":"sub","from":{"kind":"string","value":"β"},"to":{"kind":"string","value":"ss"}}]}]}],"aliases":{},"functions":{}}
